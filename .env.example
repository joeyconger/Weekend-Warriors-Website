# Environment variables for local dev and Railway deploy. Copy to .env.local
# for local overrides — Next.js loads that automatically and it's gitignored.

# Optional — overrides the hardcoded default in lib/site-config.ts.
# SLEEPER_LEAGUE_ID=1315737573154390016

# Required for real AI-written storylines. Get a free key (no credit card)
# at https://ai.google.dev. Without this set, the Storylines tab still
# works — it falls back to simpler template-generated text.
# GEMINI_API_KEY=your-gemini-api-key-here

# Optional — override the Flash-tier model used for generation. Check
# https://ai.google.dev/gemini-api/docs/models for the current fastest/
# cheapest Flash model name if this default ever goes stale.
# GEMINI_MODEL=gemini-2.5-flash

# Required to let the /api/generate-storylines endpoint run (called by the
# scheduled GitHub Actions workflow in .github/workflows/generate-storylines.yml).
# Any long random string works — it's just a shared secret.
# GENERATION_SECRET=change-me-to-something-random

# Where the storylines SQLite cache lives. On Railway, point this at a
# mounted Volume (e.g. /data/storylines.db) so it survives redeploys.
# Defaults to ./data/storylines.db locally.
# DATABASE_PATH=/data/storylines.db

# The site's public URL, used by the GitHub Actions workflow to call the
# generation endpoint. Not needed for local dev.
# SITE_URL=https://your-site.up.railway.app
